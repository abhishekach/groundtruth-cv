# Groundtruth CV reads this file from your workspace. Never commit it or share it.
# Fill in the keys for the model profile you use (see models.yaml). The default profile "balanced" needs all three.

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# platform.openai.com -> API keys
OPENAI_API_KEY=
# aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Model profile: balanced | cheap | anthropic | openai | local
GROUNDTRUTH_MODELS=balanced

# Monthly cap on model spend in US dollars, checked before every paid call.
GROUNDTRUTH_MONTHLY_BUDGET_USD=10
# Cap per command (one match or tailor run), checked before every model attempt.
GROUNDTRUTH_RUN_BUDGET_USD=2
